{
  "name": "autocap",
  "version": "0.2.0",
  "description": "Agent-native Screen Studio: coding agents script, record and verify polished product demo clips of a web app.",
  "license": "MIT",
  "type": "module",
  "bin": { "autocap": "bin/autocap.mjs", "rec": "bin/autocap.mjs" },
  "exports": { ".": "./src/index.mjs" },
  "files": ["bin", "src", "skill"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/*.e2e.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": { "playwright-core": "1.60" }
}
